# Skopiuj do .env.local (lokalnie) albo wpisz w Vercel: Settings → Environment Variables.

# Wysyłka formularza e-mailem przez Resend (zalecane na Vercelu).
# RESEND_API_KEY=re_...
# Adres, na który przychodzą zgłoszenia (kilka adresów rozdziel przecinkami).
# CONTACT_TO_EMAIL=kontakt@twoja-domena.pl
# Nadawca z domeny zweryfikowanej w Resend; bez tego Resend wysyła tylko na adres właściciela konta.
# CONTACT_FROM_EMAIL=Axoy <formularz@twoja-domena.pl>

# Albo: wysyłka zgłoszenia jako JSON pod podany adres (Make, Zapier, n8n, własny serwer).
# CONTACT_WEBHOOK_URL=https://...

# Bez powyższych: zapis do plików (tylko lokalnie lub na własnym serwerze, nie na Vercelu).
# CONTACT_STORAGE_DIR=.data/inquiries

# Opcjonalnie: publiczny adres strony, bez ścieżki. Formularz przyjmuje zgłoszenia
# z adresu, pod którym strona działa, i dodatkowo z tego.
# NEXT_PUBLIC_SITE_URL=https://axoy.pl
